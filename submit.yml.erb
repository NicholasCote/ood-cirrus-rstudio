<%-
  # ---------------------------------------------------------------------------
  # The image. Fixed here, not offered on the form: which container RStudio runs
  # in is not a decision someone opening an editor should have to make, and a
  # wrong answer produces a session that dies instantly.
  #
  # Pinned to an explicit tag. CI publishes date tags (%Y-%m-%d.%H.%M); bump this
  # to the tag you have tested, never to something floating.
  # ---------------------------------------------------------------------------
  rstudio_img = "hub.k8s.ucar.edu/ncote/rstudio-server:2026-08-21.16.02"

  utility_img = "docker.io/ohiosupercomputer/ood-k8s-utils:latest"

  user = OodSupport::User.new

  idle_timeout = 3600
  idle_check_interval = 300

  max_session_hours = 12

  workdir = working_dir.to_s.strip
  workdir = user.home if workdir.empty?

  unless workdir.match?(%r{\A/[A-Za-z0-9 ._\-/]{0,1023}\z})
    raise "Invalid working directory: #{workdir.inspect}. " \
          "Expected an absolute path built from letters, digits, spaces, " \
          "'.', '_', '-', and '/'."
  end

  base_url_file = "base_url"

  passwd_file = "csenv"
-%>
---
batch_connect:
  template: "basic"
script:
  wall_time: "<%= max_session_hours * 3600 %>"
  native:
    container:
      name: "rstudio-server"
      image: "<%= rstudio_img %>"
      command: "/usr/local/bin/entrypoint.sh rserver"
      restart_policy: "OnFailure"
      working_dir: "<%= user.home %>"
      env:
        HOME: "<%= user.home %>"
        USER: "<%= user.name %>"
        NB_USER: "<%= user.name %>"
        GROUP: "<%= user.group.name %>"

        CIRRUS_RSTUDIO_WORKDIR: "<%= workdir %>"

        CIRRUS_RSTUDIO_PORT: "8080"

        CIRRUS_RSTUDIO_AUTH: "password"
        CIRRUS_RSTUDIO_PASSWORD_FILE: "/ood/<%= passwd_file %>"

        CIRRUS_RSTUDIO_BASE_URL_FILE: "/ood/<%= base_url_file %>"

        CIRRUS_RSTUDIO_IDLE_TIMEOUT: "<%= idle_timeout %>"
        CIRRUS_RSTUDIO_IDLE_CHECK: "<%= idle_check_interval %>"
      port: 8080
      cpu: "<%= cpu.to_i %>"
      memory: "<%= memory.to_i %>Gi"
      startup_probe:
        initial_delay_seconds: 5
        failure_threshold: 60
        period_seconds: 5
    mounts:
      - type: nfs
        name: home
        host: "gladenfs.hpc.ucar.edu"
        path: "/gpfs/u/home/<%= user.name %>"
        destination_path: "<%= user.home %>"
      - type: nfs
        name: campaign
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1"
        destination_path: /glade/campaign
      - type: nfs
        name: gdex
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1/collections/gdex"
        destination_path: /gdex
      - type: nfs
        name: collections
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1/collections"
        destination_path: /glade/collections
      - type: nfs
        name: work
        host: "gladedm1.ucar.edu"
        path: "/gpfs/csfs1/work"
        destination_path: /glade/work
    configmap:
      files:
        - filename: "<%= passwd_file %>"
          mount_path: "/ood"
          data: |
        - filename: "<%= base_url_file %>"
          data: |
    init_containers:
      - name: "init-secret"
        image: "<%= utility_img %>"
        command:
          - "/bin/save_passwd_as_secret"
      - name: "add-passwd-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/passwd_from_secret; kubectl patch configmap $(hostname)-configmap --type=merge -p 'data: {<%= passwd_file %>: password='$PASSWORD'}'"
      - name: "add-baseurl-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "PORT_CFG=$(kubectl get services $(hostname)-service -o jsonpath='{.spec.ports[0].nodePort}'); HOST_CFG=$(kubectl get pods $(hostname) -o jsonpath='{.spec.nodeName}'); kubectl patch configmap $(hostname)-configmap --type=merge -p 'data: {<%= base_url_file %>: /rnode/'$HOST_CFG'/'$PORT_CFG'/}'"
