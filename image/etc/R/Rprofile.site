## Site profile for the CIRRUS RStudio image.
##
## Sets the R library path in R itself. The environment is not enough: rserver
## drops R_LIBS_USER from the session's environment, and a user's ~/.Renviron
## (which often names a Casper or Derecho library) overrides it anyway. This
## file runs after ~/.Renviron, so it wins; the user's own ~/.Rprofile still
## runs afterwards and can change it deliberately.

## rocker's own site profile: Posit Package Manager binaries for Ubuntu, so
## install.packages() downloads prebuilt packages instead of compiling.
local({
  rocker <- "/opt/cirrus-rstudio/Rprofile.site.rocker"
  if (file.exists(rocker)) source(rocker)
})

## Written by the entrypoint at session start (paths depend on $HOME). Absent
## when the image runs without the entrypoint.
local({
  session <- "/tmp/cirrus-rstudio/Rprofile.session"
  if (file.exists(session)) source(session)
})
