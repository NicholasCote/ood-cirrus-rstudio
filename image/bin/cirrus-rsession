#!/bin/bash
#
# Wrapper around rsession, named to rserver with --rsession-path.
#
# rserver does not pass its own environment to the R session; it builds a
# filtered one that drops LD_PRELOAD, NSS_WRAPPER_*, SSH_AUTH_SOCK, TMPDIR,
# XDG_CACHE_HOME and R_ENVIRON_USER (verified from /proc/<rsession>/environ).
# Without them the Terminal tab has no user name, git refuses to commit, and
# neither the Terminal nor the Git pane can reach the session's ssh-agent.
#
# So the entrypoint writes the values to a file and this puts them back, one
# exec before rsession starts. Everything rsession starts (the R process,
# terminals, git) inherits them from here.

set -u

ENV_FILE="${CIRRUS_RSTUDIO_STATE_DIR:-/tmp/cirrus-rstudio}/session-env"

if [ -r "$ENV_FILE" ]; then
    # Read, never sourced, and only the names below are accepted.
    while IFS='=' read -r name value; do
        case "$name" in
            RS_LOG_LEVEL|LD_PRELOAD|NSS_WRAPPER_PASSWD|NSS_WRAPPER_GROUP|\
            XDG_CACHE_HOME|TMPDIR|R_ENVIRON_USER|USER|LOGNAME|SSH_AUTH_SOCK)
                export "${name}=${value}" ;;
        esac
    done < "$ENV_FILE"
fi

exec /usr/lib/rstudio-server/bin/rsession "$@"
